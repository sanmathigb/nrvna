{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "coverage", "findings", "gaps"],
  "properties": {
    "file": { "type": "string" },
    "coverage": {
      "type": "string",
      "enum": ["complete", "incomplete", "uncertain"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "line_start", "line_end", "evidence"],
        "properties": {
          "claim": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "evidence": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
