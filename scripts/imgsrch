#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/nrvna-lib.sh"

# Known-good local defaults. Override with env vars or .imgsrch/config.
DEFAULT_CAPTION_MODEL="models/LFM2.5 VL 1.6B GGUF.gguf"
DEFAULT_CAPTION_MMPROJ="models/mmproj-LFM2.5-VL-1.6B-Q8_0.gguf"
DEFAULT_OCR_MODEL="models/GLM-OCR-Q8_0.gguf"
DEFAULT_OCR_MMPROJ="models/mmproj-GLM-OCR-Q8_0.gguf"
DEFAULT_EMBED_MODEL="models/nomic-embed-text-v1.5.Q8_0.gguf"

META_DOC_PREFIX="${META_DOC_PREFIX:-search_document: }"
META_QUERY_PREFIX="${META_QUERY_PREFIX:-search_query: }"
CAPTION_PROMPT="${CAPTION_PROMPT:-Return 2-4 short bullet points about this image for search indexing. Name specific entities, visible text, technical terms, topic, and key insight.}"
OCR_PROMPT="${OCR_PROMPT:-Text Recognition:}"

usage() {
    cat <<EOF
Usage:
  $0 init <project>
  $0 add <project> <image...>
  $0 index <project>
  $0 collect <project>
  $0 status <project>
  $0 search <project> <query> [top_n]
  $0 render <project>
  $0 demo <images-dir> [project]
  $0 start <project>
  $0 stop <project>
  $0 doctor [project]

imgsrch turns a folder of images into a searchable QMD notebook, powered by nrvna ai.
Models are assumed to exist locally; missing models fail clearly.
EOF
}

note() { echo "imgsrch: $*" >&2; }
err() { echo "imgsrch: $*" >&2; }

is_abs() { [[ "$1" = /* ]]; }

resolve_path() {
    local p="$1"
    if is_abs "$p"; then
        echo "$p"
    elif [ -e "$p" ]; then
        echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
    else
        echo "$p"
    fi
}

load_config() {
    local project="${1:-}"

    # Config uses `: "${VAR:=default}"`, so sourcing only fills unset vars —
    # environment always wins, project config fills the rest, then defaults.
    if [ -n "$project" ] && [ -f "$project/.imgsrch/config" ]; then
        # shellcheck disable=SC1090
        source "$project/.imgsrch/config"
    fi

    : "${CAPTION_MODEL:=$DEFAULT_CAPTION_MODEL}"
    : "${CAPTION_MMPROJ:=$DEFAULT_CAPTION_MMPROJ}"
    : "${OCR_MODEL:=$DEFAULT_OCR_MODEL}"
    : "${OCR_MMPROJ:=$DEFAULT_OCR_MMPROJ}"
    : "${EMBED_MODEL:=$DEFAULT_EMBED_MODEL}"

    CAPTION_MODEL="$(resolve_path "$CAPTION_MODEL")"
    CAPTION_MMPROJ="$(resolve_path "$CAPTION_MMPROJ")"
    OCR_MODEL="$(resolve_path "$OCR_MODEL")"
    OCR_MMPROJ="$(resolve_path "$OCR_MMPROJ")"
    EMBED_MODEL="$(resolve_path "$EMBED_MODEL")"
}

img_dir() { echo "$1/images"; }
root_dir() { echo "$1/.imgsrch"; }
items_file() { echo "$1/.imgsrch/items.tsv"; }
artifacts_dir() { echo "$1/.imgsrch/artifacts"; }
index_dir() { echo "$1/.imgsrch/index"; }
work_dir() { echo "$1/.imgsrch/workspaces"; }
caption_ws() { echo "$1/.imgsrch/workspaces/caption"; }
ocr_ws() { echo "$1/.imgsrch/workspaces/ocr"; }
embed_ws() { echo "$1/.imgsrch/workspaces/embed"; }
ensure_project() {
    local project="$1"
    mkdir -p "$(img_dir "$project")" "$(artifacts_dir "$project")" "$(index_dir "$project")" "$(work_dir "$project")"
    if [ ! -f "$(items_file "$project")" ]; then
        printf 'key\tpath\tcaption_job\tocr_job\tembed_job\n' > "$(items_file "$project")"
    fi
    if [ ! -f "$(index_dir "$project")/index.tsv" ]; then
        printf 'key\tpath\tembedding_path\n' > "$(index_dir "$project")/index.tsv"
    fi
}

write_config() {
    local project="$1"
    mkdir -p "$(root_dir "$project")"
    cat > "$project/.imgsrch/config" <<EOF
# Environment variables override these. Edit freely.
: "\${CAPTION_MODEL:=$DEFAULT_CAPTION_MODEL}"
: "\${CAPTION_MMPROJ:=$DEFAULT_CAPTION_MMPROJ}"
: "\${OCR_MODEL:=$DEFAULT_OCR_MODEL}"
: "\${OCR_MMPROJ:=$DEFAULT_OCR_MMPROJ}"
: "\${EMBED_MODEL:=$DEFAULT_EMBED_MODEL}"
EOF
}

relpath() {
    python3 - "$1" "$2" <<'PY'
import os, sys
print(os.path.relpath(os.path.abspath(sys.argv[2]), os.path.abspath(sys.argv[1])))
PY
}

content_key() {
    local path="$1"
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$path" | awk '{print substr($1,1,16)}'
    else
        md5 "$path" | awk '{print substr($NF,1,16)}'
    fi
}

collect_images() {
    local project="$1"
    local img_dir
    img_dir="$(img_dir "$project")"
    if [ ! -d "$img_dir" ]; then return; fi
    find "$img_dir" \
        -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
        | sort
}

require_file() {
    local label="$1"
    local path="$2"
    if [ ! -f "$path" ]; then
        err "Missing $label: $path"
        return 1
    fi
}

check_required_models() {
    local ok=0
    require_file "caption model" "$CAPTION_MODEL" || ok=1
    require_file "caption mmproj" "$CAPTION_MMPROJ" || ok=1
    require_file "OCR model" "$OCR_MODEL" || ok=1
    require_file "OCR mmproj" "$OCR_MMPROJ" || ok=1
    require_file "embedding model" "$EMBED_MODEL" || ok=1
    if [ "$ok" -ne 0 ]; then
        cat >&2 <<EOF

Fix one of:
  - place the model under ./models/
  - set CAPTION_MODEL/OCR_MODEL/EMBED_MODEL env vars
  - edit <project>/.imgsrch/config
EOF
        return 1
    fi
}

start_caption() {
    load_config "$1"
    check_required_models
    NRVNA_GPU_LAYERS=0 \
    NRVNA_TEMP="${NRVNA_TEMP:-0.1}" \
    NRVNA_PREDICT="${NRVNA_PREDICT:-256}" \
    NRVNA_THINKING="${NRVNA_THINKING:-0}" \
    NRVNA_BATCH="${NRVNA_BATCH:-512}" \
    NRVNA_UBATCH="${NRVNA_UBATCH:-512}" \
    NRVNA_IMAGE_MAX_TOKENS="${NRVNA_IMAGE_MAX_TOKENS:-512}" \
        nrvna_start "$CAPTION_MODEL" "$(caption_ws "$1")" --mmproj "$CAPTION_MMPROJ" -w 1
}

start_ocr() {
    load_config "$1"
    check_required_models
    NRVNA_GPU_LAYERS=0 \
    NRVNA_TEMP="${NRVNA_TEMP:-0.1}" \
    NRVNA_PREDICT="${NRVNA_PREDICT:-512}" \
    NRVNA_THINKING="${NRVNA_THINKING:-0}" \
    NRVNA_BATCH="${NRVNA_BATCH:-512}" \
    NRVNA_UBATCH="${NRVNA_UBATCH:-512}" \
        nrvna_start "$OCR_MODEL" "$(ocr_ws "$1")" --mmproj "$OCR_MMPROJ" -w 1
}

start_embed() {
    load_config "$1"
    check_required_models
    NRVNA_GPU_LAYERS=0 \
    NRVNA_BATCH="${NRVNA_BATCH:-512}" \
    NRVNA_UBATCH="${NRVNA_UBATCH:-512}" \
        nrvna_start "$EMBED_MODEL" "$(embed_ws "$1")" -w 1
}

cmd_init() {
    local project="$1"
    mkdir -p "$project"
    ensure_project "$project"
    [ -f "$project/.imgsrch/config" ] || write_config "$project"
    [ -f "$project/summary.md" ] || printf '# Summary

' > "$project/summary.md"
    [ -f "$project/search-results.md" ] || printf '# Search Results

Run `imgsrch search %s "your query"`.
' "$project" > "$project/search-results.md"
    cmd_render_qmd_only "$project"
    note "initialized $project"
}

cmd_add() {
    local project="$1"
    shift
    ensure_project "$project"
    mkdir -p "$(img_dir "$project")"
    local copied=0
    for img in "$@"; do
        if [ ! -f "$img" ]; then
            err "not a file: $img"
            continue
        fi
        cp "$img" "$(img_dir "$project")/$(basename "$img")"
        copied=$((copied + 1))
    done
    note "added $copied image(s) to $(img_dir "$project")"
}

manifest_has_key() {
    local project="$1"
    local key="$2"
    awk -F '\t' -v k="$key" 'NR>1 && $1==k { found=1 } END { exit !found }' "$(items_file "$project")"
}

cmd_index() {
    local project="$1"
    ensure_project "$project"
    load_config "$project"
    check_required_models
    start_caption "$project"
    start_ocr "$project"

    local total=0 queued=0 skipped=0
    while IFS= read -r img; do
        [ -n "$img" ] || continue
        total=$((total + 1))
        local key rel cap_job ocr_job
        key="$(content_key "$img")"
        rel="$(relpath "$project" "$img")"
        if manifest_has_key "$project" "$key"; then
            skipped=$((skipped + 1))
            continue
        fi
        cap_job="$("$NRVNA_WRK" "$(caption_ws "$project")" "$CAPTION_PROMPT" --image "$img")"
        ocr_job="$("$NRVNA_WRK" "$(ocr_ws "$project")" "$OCR_PROMPT" --image "$img")"
        printf '%s\t%s\t%s\t%s\t\n' "$key" "$rel" "$cap_job" "$ocr_job" >> "$(items_file "$project")"
        queued=$((queued + 1))
    done < <(collect_images "$project")

    echo "queued: $queued image(s)"
    echo "skipped: $skipped existing image(s)"
    echo "total:  $total image(s)"
    echo
    echo "come back later:"
    echo "  $0 status $project"
    echo "  $0 search $project \"your query\""
}

job_output_file() {
    local ws="$1"
    local job="$2"
    local name="$3"
    local path="$ws/output/$job/$name"
    [ -f "$path" ] && echo "$path"
}

write_combined() {
    local caption_file="$1"
    local ocr_file="$2"
    local out_file="$3"
    python3 - "$caption_file" "$ocr_file" "$out_file" <<'PY'
import pathlib, sys
cap = pathlib.Path(sys.argv[1]).read_text(errors='ignore').strip()
ocr = pathlib.Path(sys.argv[2]).read_text(errors='ignore').strip()
cap = ' '.join(cap.split())
if len(cap) > 900:
    cap = cap[:900].rsplit(' ', 1)[0] + '...'
out = pathlib.Path(sys.argv[3])
text = cap
if ocr:
    text += "\n\nVisible text:\n" + ocr
out.write_text(text.strip() + "\n")
PY
}

# Start the embed daemon at most once per collect run — lazy, only when
# something is actually ready to embed. Uses cmd_collect's started_embed.
ensure_embed_daemon() {
    [ "${started_embed:-0}" -eq 1 ] && return 0
    start_embed "$1" >/dev/null 2>&1
    started_embed=1
}

cmd_collect() {
    local project="$1"

    ensure_project "$project"
    load_config "$project"

    local cap_ws o_ws emb_ws started_embed
    cap_ws="$(caption_ws "$project")"
    o_ws="$(ocr_ws "$project")"
    emb_ws="$(embed_ws "$project")"
    started_embed=0

    # Single pass: advance every item as far as it can go right now, then
    # return. No polling, no waiting — nobody is watching. Re-run when you
    # come back; the filesystem holds the state between runs.
    local tmp
    tmp="$(mktemp)"
    printf 'key\tpath\tcaption_job\tocr_job\tembed_job\n' > "$tmp"

    local n_cap=0 n_ocr=0 n_comb=0 n_emb=0 n_idx=0 n_queued=0

    while IFS=$'\t' read -r key path cap_job ocr_job embed_job; do
        [ -n "${key:-}" ] || continue
        local adir="$(artifacts_dir "$project")/$key"
        mkdir -p "$adir"
        local cap_file="$adir/caption.txt"
        local ocr_file="$adir/ocr.txt"
        local combined_file="$adir/combined.md"
        local emb_file="$adir/embedding.json"

        if [ -n "${cap_job:-}" ] && [ ! -f "$cap_file" ] && [ -f "$cap_ws/output/$cap_job/result.txt" ]; then
            cp "$cap_ws/output/$cap_job/result.txt" "$cap_file"
            n_cap=$((n_cap + 1))
        fi

        if [ -n "${ocr_job:-}" ] && [ ! -f "$ocr_file" ] && [ -f "$o_ws/output/$ocr_job/result.txt" ]; then
            cp "$o_ws/output/$ocr_job/result.txt" "$ocr_file"
            n_ocr=$((n_ocr + 1))
        fi

        if [ -f "$cap_file" ] && [ -f "$ocr_file" ] && [ ! -f "$combined_file" ]; then
            write_combined "$cap_file" "$ocr_file" "$combined_file"
            n_comb=$((n_comb + 1))
        fi

        if [ -f "$combined_file" ] && [ -z "${embed_job:-}" ]; then
            ensure_embed_daemon "$project"
            local payload
            payload="$(tr '\n' ' ' < "$combined_file")"
            embed_job="$(printf '%s%s\n' "$META_DOC_PREFIX" "$payload" | "$NRVNA_WRK" "$emb_ws" - --embed)"
            n_queued=$((n_queued + 1))
        fi

        if [ -n "${embed_job:-}" ] && [ ! -f "$emb_file" ] && [ -f "$emb_ws/output/$embed_job/embedding.json" ]; then
            cp "$emb_ws/output/$embed_job/embedding.json" "$emb_file"
            n_emb=$((n_emb + 1))
        fi

        if [ -f "$emb_file" ] && ! awk -F '\t' -v k="$key" 'NR>1 && $1==k{f=1} END{exit !f}' "$(index_dir "$project")/index.tsv"; then
            printf '%s\t%s\t%s\n' "$key" "$path" ".imgsrch/artifacts/$key/embedding.json" >> "$(index_dir "$project")/index.tsv"
            n_idx=$((n_idx + 1))
        fi

        printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$path" "${cap_job:-}" "${ocr_job:-}" "${embed_job:-}" >> "$tmp"
    done < <(tail -n +2 "$(items_file "$project")")

    mv "$tmp" "$(items_file "$project")"

    local total indexed
    total=$(($(wc -l < "$(items_file "$project")") - 1))
    indexed=$(($(wc -l < "$(index_dir "$project")/index.tsv") - 1))
    echo "advanced: caption +$n_cap | ocr +$n_ocr | combined +$n_comb | embed +$n_emb (queued $n_queued) | searchable $indexed/$total"
}

count_files() {
    local dir="$1" name="$2"
    [ -d "$dir" ] || { echo 0; return; }
    find "$dir" -mindepth 2 -maxdepth 2 -name "$name" -type f | wc -l | tr -d ' '
}

workspace_counts() {
    local ws="$1"
    if [ -d "$ws" ] && [ -n "$NRVNA_FLW" ] && [ -x "$NRVNA_FLW" ]; then
        "$NRVNA_FLW" "$ws" --json 2>/dev/null || echo '{}'
    else
        echo '{}'
    fi
}

cmd_status() {
    local project="$1"
    ensure_project "$project"
    local total caption_done ocr_done combined_done embed_done indexed
    total=$(($(wc -l < "$(items_file "$project")") - 1))
    caption_done="$(count_files "$(artifacts_dir "$project")" caption.txt)"
    ocr_done="$(count_files "$(artifacts_dir "$project")" ocr.txt)"
    combined_done="$(count_files "$(artifacts_dir "$project")" combined.md)"
    embed_done="$(count_files "$(artifacts_dir "$project")" embedding.json)"
    indexed=$(($(wc -l < "$(index_dir "$project")/index.tsv") - 1))
    printf 'images:   %s\n' "$total"
    printf 'caption:  %s done / %s\n' "$caption_done" "$total"
    printf 'ocr:      %s done / %s\n' "$ocr_done" "$total"
    printf 'combined: %s ready\n' "$combined_done"
    printf 'embed:    %s done\n' "$embed_done"
    printf 'search:   %s indexed\n' "$indexed"
}

cmd_search() {
    local project="$1"
    local query="$2"
    local top_n="${3:-5}"
    ensure_project "$project"
    cmd_collect "$project"
    load_config "$project"
    check_required_models
    local indexed
    indexed=$(($(wc -l < "$(index_dir "$project")/index.tsv") - 1))
    if [ "$indexed" -le 0 ]; then
        err "nothing indexed yet; run '$0 status $project' and try again later"
        return 1
    fi

    start_embed "$project" >/dev/null
    local q_json q_job out_md
    q_json="$(mktemp)"
    q_job="$(printf '%s%s\n' "$META_QUERY_PREFIX" "$query" | "$NRVNA_WRK" "$(embed_ws "$project")" - --embed)"
    "$NRVNA_FLW" "$(embed_ws "$project")" -w "$q_job" --json > "$q_json"
    out_md="$project/search-results.md"

    python3 - "$project" "$q_json" "$query" "$top_n" "$out_md" <<'PY'
import json, math, pathlib, re, sys
project = pathlib.Path(sys.argv[1])
q_json = pathlib.Path(sys.argv[2])
query = sys.argv[3]
top_n = int(sys.argv[4])
out_md = pathlib.Path(sys.argv[5])
idx = project / '.imgsrch' / 'index' / 'index.tsv'
artifacts = project / '.imgsrch' / 'artifacts'

def load_vec(path):
    raw = json.loads(path.read_text())
    if isinstance(raw, dict):
        raw = raw.get('vector', raw.get('embedding', raw))
    if isinstance(raw, dict):
        raw = raw.get('vector')
    return raw if isinstance(raw, list) else None

def norm(v): return math.sqrt(sum(x*x for x in v))
def cosine(a,b):
    na, nb = norm(a), norm(b)
    return 0.0 if na == 0 or nb == 0 else sum(x*y for x,y in zip(a,b))/(na*nb)
def toks(s): return re.findall(r"[a-z0-9_+.#/-]+", s.lower())
def bm25(query_tokens, doc_tokens, avg_dl, df, N, k1=1.5, b=0.75):
    if not query_tokens or not doc_tokens: return 0.0
    tf = {}
    for t in doc_tokens: tf[t] = tf.get(t,0)+1
    score = 0.0
    dl = len(doc_tokens)
    for term in query_tokens:
        if term not in tf: continue
        dfi = df.get(term, 0)
        idf = math.log((N - dfi + 0.5)/(dfi + 0.5) + 1.0)
        score += idf * (tf[term]*(k1+1))/(tf[term] + k1*(1-b+b*dl/max(avg_dl,1)))
    return score

qdata = json.loads(q_json.read_text())
emb = qdata.get('embedding', {})
qvec = emb.get('vector', emb) if isinstance(emb, dict) else emb
if not isinstance(qvec, list):
    raise SystemExit('missing query embedding')

rows=[]
for line in idx.read_text().splitlines()[1:]:
    if not line.strip(): continue
    parts=line.split('\t')
    if len(parts)<3: continue
    key,path,emb_path=parts[0],parts[1],parts[2]
    combined=artifacts/key/'combined.md'
    emb_file=artifacts/key/'embedding.json'
    if not combined.exists() or not emb_file.exists(): continue
    text=combined.read_text(errors='ignore')
    vec=load_vec(emb_file)
    if vec is None: continue
    rows.append({'key':key,'path':path,'text':text,'tokens':toks(text),'dense':cosine(qvec,vec)})

N=len(rows)
df={}
for r in rows:
    for t in set(r['tokens']): df[t]=df.get(t,0)+1
avg=sum(len(r['tokens']) for r in rows)/N if N else 1
qt=toks(query)
for r in rows:
    r['bm25']=bm25(qt,r['tokens'],avg,df,N)
max_b=max((r['bm25'] for r in rows), default=0.0)
for r in rows:
    b=(r['bm25']/max_b) if max_b>0 else 0.0
    r['score']=0.5*r['dense']+0.5*b
rows=sorted(rows,key=lambda r:r['score'],reverse=True)[:top_n]

lines=[f"# Search: {query}", ""]
for i,r in enumerate(rows,1):
    snippet=' '.join(r['text'].split())
    if len(snippet)>320: snippet=snippet[:320].rsplit(' ',1)[0]+'...'
    lines += [f"## {i}. {pathlib.Path(r['path']).name}", "", f"Score: `{r['score']:.3f}`  Dense: `{r['dense']:.3f}`  BM25: `{r['bm25']:.3f}`", "", f"Image: `{r['path']}`", "", f"![]({r['path']})", "", "> " + snippet, ""]
    print(f"[{r['score']:.3f}] {r['path']}  (dense={r['dense']:.3f} bm25={r['bm25']:.3f})")
    print(snippet)
    print()
out_md.write_text('\n'.join(lines))
PY
    rm -f "$q_json"
    echo "wrote: $out_md" >&2
}

cmd_render_qmd_only() {
    local project="$1"
    ensure_project "$project"
    local gallery="$project/.imgsrch/gallery.qmd"
    {
        echo '# Gallery'
        echo
        if [ -f "$(index_dir "$project")/index.tsv" ]; then
            tail -n +2 "$(index_dir "$project")/index.tsv" | while IFS=$'\t' read -r key path emb_path; do
                [ -n "${key:-}" ] || continue
                local combined
                combined="$(artifacts_dir "$project")/$key/combined.md"
                echo "## $(basename "$path")"
                echo
                echo "![]($path)"
                echo
                if [ -f "$combined" ]; then
                    echo '```'
                    sed -n '1,80p' "$combined"
                    echo '```'
                    echo
                fi
            done
        fi
    } > "$gallery"

    cat > "$project/index.qmd" <<EOF
---
title: "imgsrch notebook"
subtitle: "Built with nrvna ai"
format:
  html:
    toc: true
---

# Summary

{{< include summary.md >}}

# Latest Search

{{< include search-results.md >}}

{{< include .imgsrch/gallery.qmd >}}
EOF
}

cmd_render() {
    local project="$1"
    cmd_render_qmd_only "$project"
    if command -v quarto >/dev/null 2>&1; then
        (cd "$project" && quarto render index.qmd)
        note "rendered $project/index.html"
    else
        note "wrote $project/index.qmd"
        note "install Quarto to render HTML: https://quarto.org/docs/get-started/"
    fi
}

cmd_doctor() {
    local project="${1:-}"
    [ -n "$project" ] && ensure_project "$project"
    load_config "$project"
    local ok=0
    echo "binaries:"
    for pair in "nrvnad:$NRVNA_DAEMON" "wrk:$NRVNA_WRK" "flw:$NRVNA_FLW"; do
        local name path
        name="${pair%%:*}"; path="${pair#*:}"
        if [ -z "$path" ] || [ ! -x "$path" ]; then echo "  ✗ $name missing"; ok=1
        elif [ ! -s "$path" ] || ! "$path" --version >/dev/null 2>&1; then echo "  ✗ $name broken (zero-byte or won't run): $path"; ok=1
        else echo "  ✓ $name $path"; fi
    done
    [ -x "$SCRIPT_DIR/media-search" ] && echo "  ✓ media-search $SCRIPT_DIR/media-search" || echo "  - media-search not needed for imgsrch"
    echo
    echo "models:"
    for pair in "caption:$CAPTION_MODEL" "caption-mmproj:$CAPTION_MMPROJ" "ocr:$OCR_MODEL" "ocr-mmproj:$OCR_MMPROJ" "embed:$EMBED_MODEL"; do
        local name path
        name="${pair%%:*}"; path="${pair#*:}"
        if [ -f "$path" ]; then echo "  ✓ $name $path"; else echo "  ✗ $name $path"; ok=1; fi
    done
    echo
    echo "optional:"
    command -v quarto >/dev/null 2>&1 && echo "  ✓ quarto $(command -v quarto)" || echo "  - quarto not found (HTML render disabled)"
    command -v qmd >/dev/null 2>&1 && echo "  ✓ qmd $(command -v qmd)" || echo "  - qmd not found (not required)"
    return "$ok"
}

cmd_start() {
    local project="$1"
    ensure_project "$project"
    start_caption "$project"
    start_ocr "$project"
    start_embed "$project"
}

cmd_stop() {
    local project="$1"
    nrvna_stop "$(caption_ws "$project")" || true
    nrvna_stop "$(ocr_ws "$project")" || true
    nrvna_stop "$(embed_ws "$project")" || true
}

cmd_demo() {
    local images_dir="$1"
    local project="${2:-imgsrch-demo}"
    if [ ! -d "$images_dir" ]; then
        err "images dir not found: $images_dir"
        return 1
    fi
    cmd_init "$project"
    while IFS= read -r img; do
        cp "$img" "$(img_dir "$project")/$(basename "$img")"
    done < <(find "$images_dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) | sort)
    cmd_doctor "$project"
    cmd_index "$project"
    echo
    echo "demo queued. Collecting for a while so you can see results..."
    local waited=0 max_wait="${IMGSRCH_DEMO_WAIT:-900}"
    while [ "$waited" -lt "$max_wait" ]; do
        cmd_collect "$project" >/dev/null
        local total indexed
        total=$(($(wc -l < "$(items_file "$project")") - 1))
        indexed=$(($(wc -l < "$(index_dir "$project")/index.tsv") - 1))
        echo "indexed $indexed / $total"
        [ "$total" -gt 0 ] && [ "$indexed" -ge "$total" ] && break
        sleep 5
        waited=$((waited + 5))
    done
    # demo keeps going even if nothing indexed in time — still render the gallery
    cmd_search "$project" "${IMGSRCH_DEMO_QUERY:-technical terms visible text}" 5 || true
    cmd_render "$project"
    echo
    echo "project: $project"
}

cmd="${1:-}"
case "$cmd" in
    init)    [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_init "$2" ;;
    add)     [ "$#" -ge 3 ] || { usage >&2; exit 1; }; project="$2"; shift 2; cmd_add "$project" "$@" ;;
    index)   [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_index "$2" ;;
    collect) [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_collect "$2" ;;
    status)  [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_status "$2" ;;
    search)  [ "$#" -ge 3 ] || { usage >&2; exit 1; }; cmd_search "$2" "$3" "${4:-5}" ;;
    render)  [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_render "$2" ;;
    demo)    [ "$#" -ge 2 ] || { usage >&2; exit 1; }; cmd_demo "$2" "${3:-imgsrch-demo}" ;;
    doctor)  cmd_doctor "${2:-}" ;;
    start)   [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_start "$2" ;;
    stop)    [ "$#" -eq 2 ] || { usage >&2; exit 1; }; cmd_stop "$2" ;;
    -h|--help|"") usage ;;
    *) usage >&2; exit 1 ;;
esac
