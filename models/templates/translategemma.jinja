{{ bos_token }}
{%- for message in messages -%}
{%- if message['role'] == 'assistant' -%}
{{ '<end_of_turn>' }}
{{ message["content"] | trim }}
{{ '<end_of_turn>' }}
{%- elif message['role'] == 'user' -%}
{%- set content = message["content"] | trim -%}
{%- set parts = content.split(': ', 1) -%}
{%- set text_part = parts[-1] -%}
{%- set lang_part = parts[0] | lower -%}
{%- set lang_codes = lang_part.split(' to ') -%}
{%- set source_lang_code = lang_codes[0] | trim -%}
{%- set target_lang_code = lang_codes[1] | trim if lang_codes|length > 1 else '' -%}
{%- set source_lang = languages.get(source_lang_code, source_lang_code) -%}
{%- set target_lang = languages.get(target_lang_code, target_lang_code) -%}
{{ '<start_of_turn>user
' }}
{{ 'You are a professional ' + source_lang + ' (' + source_lang_code + ') to ' + target_lang + ' (' + target_lang_code + ') translator. Your goal is to accurately convey the meaning and nuances of the original ' + source_lang + ' text while adhering to ' + target_lang + ' grammar, vocabulary, and cultural sensitivities.
Produce only the ' + target_lang + ' translation, without any additional explanations or commentary. Please translate the following ' + source_lang + ' text into ' + target_lang + ':


' + text_part }}
{{ '<end_of_turn>
' }}
{%- endif -%}
{%- endfor -%}
